# Public source URL and API key supplied with the assignment (keep your copy local).
ORDERS_SOURCE_URL=https://jzozteoirwfczccltcdr.supabase.co/rest/v1/orders_raw
ORDERS_SOURCE_API_KEY=replace_with_assignment_key

# SQLite is the zero-setup local default. Absolute paths are also supported.
DATABASE_PATH=data/aqurate.db

# Optional persistent PostgreSQL/Supabase target. When set, it takes precedence
# over DATABASE_PATH. Keep this value private; GitHub Actions uses its own secret.
# DATABASE_URL=postgresql://postgres:password@host:5432/postgres?sslmode=require
FX_API_URL=https://api.frankfurter.dev/v1
HTTP_TIMEOUT_SECONDS=30
